#!/usr/bin/env bash
set +x
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
environment="${1:-}"
[[ "$environment" == staging || "$environment" == production ]] || { echo 'Usage: ./deploy-to staging|production [options]' >&2; exit 1; }
shift
env_file="$repo_dir/deploy/$environment.env"
check_only=0
build_only=0
library=0
seed=0
rollback=
artifact=
while (($#)); do
    case "$1" in
        --check) check_only=1 ;;
        --build-only) build_only=1 ;;
        --with-library) library=1 ;;
        --seed-catalog) seed=1 ;;
        --rollback) shift; rollback="${1:?Provide a release ID}" ;;
        --artifact) shift; artifact="${1:?Provide a built artifact path}" ;;
        --help|-h)
            echo 'Usage: ./deploy-to staging|production [--build-only] [--with-library] [--seed-catalog]'
            echo '       ./deploy-to staging|production --rollback RELEASE_ID'
            echo '       ./deploy-to staging|production --artifact deploy/builds/RELEASE_ID.tar.gz [--with-library] [--seed-catalog]'
            echo '       ./deploy-to staging|production --check'
            echo 'Deploy/rollback require PLOI_API_TOKEN or the private local token file; --build-only does not.'
            exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
    shift
done
ssh_options=(-o BatchMode=yes -o ConnectTimeout=15)
if [[ -z "${SENTRY_AUTH_TOKEN:-}" && -f "$repo_dir/deploy/betterstack.env" ]]; then
    # Parse the upload token as data; never execute a private dotenv file.
    SENTRY_AUTH_TOKEN="$(python3 - "$repo_dir/deploy/betterstack.env" <<'PY'
import re, sys
from pathlib import Path
match = re.search(r'^SENTRY_AUTH_TOKEN=([A-Za-z0-9_-]+)$', Path(sys.argv[1]).read_text(), re.MULTILINE)
if not match:
    raise SystemExit('Invalid Better Stack upload token configuration')
print(match.group(1))
PY
)"
    export SENTRY_AUTH_TOKEN
fi
workspace=
runtime_env=
cleanup() {
    [[ -z "$workspace" ]] || rm -rf -- "$workspace"
    [[ -z "$runtime_env" ]] || rm -f -- "$runtime_env"
}
trap cleanup EXIT
if ((!build_only || check_only)); then
    metadata="$(python3 "$repo_dir/deploy/environment.py" describe "$environment" "$env_file")"
    mapfile -t target <<< "$metadata"
    server="${target[0]}"
    site="${target[1]}"
    hostname="${target[2]}"
    database="${target[3]}"
    ploi_server_id="${target[4]}"
    ploi_site_id="${target[5]}"
fi
if ((check_only)); then
    ((build_only == 0 && library == 0 && seed == 0)) && [[ -z "$rollback$artifact" ]] || { echo '--check cannot be combined with deployment options' >&2; exit 1; }
    echo "Configuration valid for $environment: $hostname"
    exit 0
fi
if ((!build_only)); then
    # Read a local secret as data; never execute a credentials file as shell code.
    token_file="${XDG_CONFIG_HOME:-$HOME/.config}/equi-app/ploi-api-token"
    if [[ -z "${PLOI_API_TOKEN:-}" && -f "$token_file" ]]; then
        [[ -O "$token_file" && "$(stat -c %a -- "$token_file")" == 600 ]] || {
            echo 'The local Ploi token file must belong to you and have mode 600.' >&2; exit 1;
        }
        PLOI_API_TOKEN="$(<"$token_file")"
    fi
    [[ -n "${PLOI_API_TOKEN:-}" ]] || { echo 'Set PLOI_API_TOKEN or save it in ~/.config/equi-app/ploi-api-token (mode 600; not needed for --build-only).' >&2; exit 1; }
fi
remote_activate() {
    ssh "${ssh_options[@]}" "$server" "mkdir -p '$site/shared/deploy-tools'"
    rsync -a -e 'ssh -o BatchMode=yes -o ConnectTimeout=15' "$repo_dir/deploy/ploi-nginx.php" "$server:$site/shared/deploy-tools/"
    # Upload runtime configuration separately from the immutable/public build.
    # Activation installs it atomically under the deployment lock.
    if [[ "$2" == deploy ]]; then
        runtime_env="$(mktemp)"
        python3 "$repo_dir/deploy/environment.py" runtime "$env_file" "$runtime_env"
        rsync -a --chmod=F600 -e 'ssh -o BatchMode=yes -o ConnectTimeout=15' "$runtime_env" "$server:$site/incoming/$1.env"
    fi
    # Feed the token over encrypted stdin, never command arguments or release files.
    {
        printf 'export PLOI_API_TOKEN=%q\n' "$PLOI_API_TOKEN"
        printf 'export DEPLOY_ENVIRONMENT=%q DEPLOY_HOSTNAME=%q DEPLOY_DATABASE=%q DEPLOY_PLOI_SERVER_ID=%q DEPLOY_PLOI_SITE_ID=%q\n' \
            "$environment" "$hostname" "$database" "$ploi_server_id" "$ploi_site_id"
        cat "$repo_dir/deploy/activate-release.sh"
    } | ssh "${ssh_options[@]}" "$server" bash -s -- "$site" "$1" "$2" "$3" "$4"
}
if [[ -n "$rollback" ]]; then
    [[ "$rollback" =~ ^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{7,12}-[a-f0-9]{6}$ ]] || { echo 'Invalid release ID' >&2; exit 1; }
    ((build_only == 0 && library == 0 && seed == 0)) && [[ -z "$artifact" ]] || { echo 'Rollback cannot be combined with build/import options' >&2; exit 1; }
    remote_activate "$rollback" rollback 0 0
    exit
fi

for command in rsync tar sha256sum; do command -v "$command" >/dev/null; done
if ((library)); then
    [[ -f "$repo_dir/deploy/lib-assets/manifest.json" ]] || { echo 'Export the library bundle first: ./deploy-library-items --export' >&2; exit 1; }
fi
if ((!build_only)); then
    ssh "${ssh_options[@]}" "$server" "test -r '$site/shared/.env' && command -v php8.5 && command -v rsync && command -v pg_dump && test -w '$site/incoming'" >/dev/null
fi

if [[ -z "$artifact" ]]; then
    command -v docker >/dev/null
    revision="$(git -C "$repo_dir" rev-parse --short=12 HEAD)"
    release="$(date -u +%Y%m%dT%H%M%SZ)-$revision-$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')"
    mkdir -p "$repo_dir/deploy/builds"
    workspace="$(mktemp -d "$repo_dir/deploy/builds/.build-XXXXXX")"
    mkdir -p "$workspace/app"

    # An allowlist keeps credentials, local uploads, dev caches and tooling out.
    bash "$repo_dir/deploy/package-backend.sh" "$repo_dir/backend" "$workspace/app"
    # The admin preview imports shared protocol helpers from the Expo app.
    # Prepare the same filtered sources used by the web build before compiling it.
    bash "$repo_dir/deploy/package-web.sh" "$repo_dir" "$workspace/frontend"
    mkdir -p "$workspace/app/.deploy" "$workspace/app/bootstrap/cache" \
        "$workspace/app/storage/framework/"{cache/data,sessions,views} "$workspace/app/storage/logs"
    cp "$repo_dir/deploy/nginx-staging.conf" "$workspace/app/.deploy/"
    cp "$repo_dir/deploy/build-backend.sh" "$repo_dir/deploy/check-release.php" "$repo_dir/deploy/render-nginx.php" "$repo_dir/deploy/backup-database.php" "$workspace/app/.deploy/"
    printf '%s\n' "$release" > "$workspace/app/RELEASE_ID"
    git -C "$repo_dir" status --porcelain > "$workspace/app/.deploy/source-status.txt"

    image=sail-8.5/app
    if ! docker image inspect "$image" >/dev/null 2>&1; then
        (cd "$repo_dir/backend" && docker compose build laravel.test)
    fi
    echo "Building $release in Docker ($image)..."
    docker run --rm --user "$(id -u):$(id -g)" --entrypoint bash \
        --env COMPOSER_HOME=/tmp/equi-composer --env npm_config_cache=/tmp/equi-npm \
        --env XDEBUG_MODE=off --volume "$workspace/app:/build" \
        --env VITE_BETTER_STACK_ENVIRONMENT="$environment" --env VITE_BETTER_STACK_RELEASE="$release" \
        --env SENTRY_AUTH_TOKEN \
        --volume "$workspace/frontend/expo-app/lib:/expo-app/lib:ro" --workdir /build \
        "$image" .deploy/build-backend.sh
    echo 'Building the customer web app in an isolated Node 24 container...'
    web_image=equi-app/web-build:node24
    # Read only the Dockerfile through stdin; no runtime secrets enter its context.
    docker build --tag "$web_image" - < "$repo_dir/deploy/Dockerfile.web"
    cp "$repo_dir/deploy/build-web.sh" "$workspace/frontend/build-web.sh"
    docker run --rm --user "$(id -u):$(id -g)" --entrypoint bash \
        --env npm_config_cache=/tmp/equi-npm --env EXPO_NO_TELEMETRY=1 \
        --env EXPO_PUBLIC_BETTER_STACK_ENVIRONMENT="$environment" --env EXPO_PUBLIC_BETTER_STACK_RELEASE="$release" \
        --env SENTRY_AUTH_TOKEN \
        --volume "$workspace/frontend:/build" --workdir /build/web \
        "$web_image" /build/build-web.sh
    mv "$workspace/frontend/web/dist" "$workspace/app/web-dist"
    artifact="$repo_dir/deploy/builds/$release.tar.gz"
    tar -czf "$artifact" -C "$workspace/app" .
    (cd "$repo_dir/deploy/builds" && sha256sum "$release.tar.gz" > "$release.tar.gz.sha256")
    echo "Built: $artifact"
    ((build_only)) && exit 0
else
    ((build_only == 0)) || { echo '--artifact and --build-only are mutually exclusive' >&2; exit 1; }
    artifact="$(realpath -- "$artifact")"
    release="$(basename -- "$artifact" .tar.gz)"
    [[ "$release" =~ ^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{7,12}-[a-f0-9]{6}$ && "$artifact" == *.tar.gz ]] || { echo 'Invalid artifact name' >&2; exit 1; }
    (cd "$(dirname -- "$artifact")" && sha256sum -c "$release.tar.gz.sha256")
fi

if ((library)); then
    echo 'Uploading library bundle (resumable; only changed files transfer)...'
    rsync -a --partial -e 'ssh -o BatchMode=yes -o ConnectTimeout=15' \
        "$repo_dir/deploy/lib-assets/" "$server:$site/shared/lib-assets/"
fi
rsync -a --partial -e 'ssh -o BatchMode=yes -o ConnectTimeout=15' \
    "$artifact" "$artifact.sha256" "$server:$site/incoming/"
remote_activate "$release" deploy "$library" "$seed"
