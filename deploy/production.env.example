# Laravel runtime configuration. PLOI_API_TOKEN belongs only in the local/CI
# deployment environment, never in this file or the server Laravel .env.
APP_NAME="EquiApp"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
FFMPEG_BINARY=
PUBLIC_STORAGE_URL=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="EquiApp"
POWERSYNC_KEY_ID=
POWERSYNC_ISSUER=
POWERSYNC_AUDIENCE=equinova
# Reserved for the separate PowerSync service; not provisioned by code deployment.
POWERSYNC_SERVICE_URL=
POWERSYNC_URL=http://127.0.0.1:8080
POWERSYNC_METRICS_URL=http://127.0.0.1:9090/metrics
VITE_APP_NAME="EquiApp"

# Configure the production target and credentials before deploying.
DEPLOY_SSH_HOST=
DEPLOY_SITE_PATH=
DEPLOY_PLOI_SERVER_ID=
DEPLOY_PLOI_SITE_ID=

# Better Stack backend error tracking (public ingestion DSN).
BETTER_STACK_DSN=https://cJM1hRGwVPPusFFhkuf3AeJx@s2781659.us-west-2a.betterstackdata.com/2781659
BETTER_STACK_ENVIRONMENT=production
