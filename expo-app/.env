# Reach the host's loopback from the Android emulator. iOS simulators can
# use http://localhost directly. For a physical device, put the host
# machine's LAN IP and the backend's exposed APP_PORT in an untracked
# .env.local (it overrides this file), e.g.
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.209:81
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:81
