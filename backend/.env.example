APP_NAME="EquiApp"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:81
APP_PORT=81

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PUBLIC_STORAGE_URL=http://192.168.1.209:81/storage
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# TransIP mailbox SMTP. Add the full mailbox address and password below.
# MAIL_FROM_ADDRESS follows MAIL_USERNAME unless explicitly overridden.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.transip.email
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="EquiApp"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

POWERSYNC_PORT=8080
POWERSYNC_PG_PASSWORD=powersync_password
POWERSYNC_JWKS_URL=http://laravel.test/.well-known/jwks.json
FORWARD_DB_PORT=5433
FORWARD_MONGO_PORT=27017

# Customer web app URL used after resetting a password (defaults to APP_URL).
# WEB_APP_URL=http://localhost:3000

# Better Stack backend error tracking (public ingestion DSN).
BETTER_STACK_DSN=https://cJM1hRGwVPPusFFhkuf3AeJx@s2781659.us-west-2a.betterstackdata.com/2781659
BETTER_STACK_ENVIRONMENT=local
# BETTER_STACK_RELEASE= (defaults to deployment RELEASE_ID)
