{
  "version": 1,
  "section": "custom-safety",
  "marker_field": "_event",
  "state_field": "_needs_confirmation",
  "state_value": "open",
  "clear_value": "closed",
  "actions": [
    "submit",
    "preview",
    "protocol"
  ],
  "triggers": [
    {
      "id": "urgent",
      "when": {
        "condition": [
          "urgent",
          "legacy urgent"
        ]
      },
      "renew": true,
      "notice": "urgent-warning",
      "popup": true,
      "critical_fields": [
        "condition"
      ],
      "block_while_matching": false
    },
    {
      "id": "ongoing",
      "when": {
        "condition": [
          "previous"
        ],
        "recovered": [
          "not yet",
          "uncertain"
        ]
      },
      "renew": false,
      "notice": "ongoing-warning",
      "popup": false,
      "critical_fields": [],
      "block_while_matching": true
    }
  ],
  "recovery": {
    "require": {
      "resolved": [
        "confirmed"
      ],
      "stable": [
        "approved"
      ]
    },
    "conditional": [
      {
        "when": {
          "condition": [
            "previous"
          ]
        },
        "require": {
          "recovered": [
            "recovered"
          ]
        }
      }
    ],
    "intro": "recovery-intro",
    "after": "stable"
  },
  "messages": {
    "blocked": "Je antwoorden blijven opgeslagen. Intake versturen en EquiBoost-protocol opstellen zijn geblokkeerd totdat de herstelstatus is bevestigd.",
    "confirm": "Herstelstatus bevestigen",
    "update": "Herstelstatus bijwerken",
    "acknowledge": "Begrepen, verder invullen",
    "pending": "De melding wordt gesynchroniseerd. Bevestigen is beschikbaar zodra je online bent en de melding is opgeslagen."
  },
  "release_source": "owner_confirmation"
}
