# Server-side targets; never put credentials in EXPO_PUBLIC_* variables.
BACKEND_URL=http://127.0.0.1:81
POWERSYNC_URL=http://127.0.0.1:8080
HOST=127.0.0.1
PORT=3000
METRO_PORT=8082

# Public ingestion DSN is configured by default. Empty disables reporting.
# EXPO_PUBLIC_BETTER_STACK_DSN=
EXPO_PUBLIC_BETTER_STACK_ENVIRONMENT=development
EXPO_PUBLIC_BETTER_STACK_ENABLED=false
# EXPO_PUBLIC_BETTER_STACK_RELEASE=
# Private, build-time source-map upload token; never prefix it EXPO_PUBLIC_.
# SENTRY_AUTH_TOKEN=
